# Copy to .env and fill in. The backend reads these when it first needs them.

# Postgres with pgvector. On Supabase: the session pooler connection string (port 5432, not 6543).
DATABASE_URL=

# Every upload and question spends money on this key.
OPENAI_API_KEY=
# Leave empty for api.openai.com; set it for an OpenAI-compatible server with structured output.
OPENAI_BASE_URL=

# Defaults from backend/loreos/settings.py. The embedding model must return 1536 dimensions.
EMBEDDING_MODEL=text-embedding-3-small
ANSWER_MODEL=gpt-5.4-mini
# The evaluation's faithfulness judge (npm run paid:eval only). A different model from ANSWER_MODEL avoids self-preference.
JUDGE_MODEL=gpt-6-luna

# The local reranker: on or off. The default retrieval mode, hybrid_rerank (decision 0010), loads it at api startup:
# a 0.08 GB download on the first start outside the image, and about 2 s of CPU per question. off serves vector search
# alone instead, without a deploy.
RERANK=on

# Host names the api answers, comma-separated. Add your domain when serving beyond this machine.
# Behind a reverse proxy, also set FORWARDED_ALLOW_IPS to the proxy's address (read by uvicorn, not by LoreOS), never *.
ALLOWED_HOSTS=localhost,127.0.0.1
